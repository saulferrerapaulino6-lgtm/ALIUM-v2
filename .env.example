PORT=4174
HOST=127.0.0.1
# URL pública usada en los enlaces de los correos y del seguimiento
PUBLIC_SITE_URL=http://127.0.0.1:4174
# Base de datos gratuita de Neon (Connection string). Sin esto, las cuentas y los pedidos quedan desactivados.
DATABASE_URL=
# Correo transaccional (Resend). Sin esto, los avisos quedan desactivados.
RESEND_API_KEY=
EMAIL_FROM=
# Nota: no se usan marketplaces externos ni ADMIN_TOKEN. ALIUM compra a proveedores locales.
# El panel admin valida una clave cuyo hash vive en Neon (alium_settings.admin_key_hash).
# El número de WhatsApp y el costo de armado se configuran en public/assets/alium-config.js.
