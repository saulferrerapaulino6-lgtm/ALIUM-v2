{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ALIUM: ejecutar servidor",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PORT": "4176" },
      "serverReadyAction": {
        "pattern": "ALIUM local: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
